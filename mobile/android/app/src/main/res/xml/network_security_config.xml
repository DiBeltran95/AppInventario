<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de tráfico de red.

  Desde Android 9 (API 28) el tráfico HTTP en claro está bloqueado por defecto.
  La tentación es poner `android:usesCleartextTraffic="true"` y olvidarse, pero
  esta app transmite ventas y credenciales por el wifi de una tienda: cualquiera
  en esa red podría leerlas. Así que el valor por defecto se deja en NO.

  Sólo se permite HTTP en claro contra el propio equipo, que es donde corre el
  backend durante el desarrollo:
    · 10.0.2.2      → la máquina anfitriona vista desde el emulador de Android
    · localhost     → backend en el propio dispositivo
    · 127.0.0.1     → idem

  ── Si alojas el backend en tu red local (por ejemplo http://192.168.1.50:3100)
     tienes dos caminos:

     1. RECOMENDADO: publícalo con HTTPS. alwaysdata ya te da un certificado, y
        entonces no hay que tocar nada de este archivo.

     2. Si de verdad necesitas HTTP en la LAN, añade la IP concreta aquí abajo
        como un <domain> más. Android no admite rangos CIDR, así que hay que
        listar la dirección exacta. Es tedioso a propósito: obliga a decidir
        conscientemente qué destino queda sin cifrar.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Añade aquí la IP de tu servidor si lo sirves por HTTP en la LAN:
        <domain includeSubdomains="false">192.168.1.50</domain>
        -->
    </domain-config>
</network-security-config>
