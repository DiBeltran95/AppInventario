# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3100
# Orígenes permitidos para CORS, separados por coma. La app móvil no usa CORS,
# pero sí lo hace cualquier panel web que agregues después.
CORS_ORIGINS=http://localhost:5173,http://localhost:3100

# ─── Base de datos (MariaDB 11.4) ────────────────────────────────────────────
DB_HOST=mysql-inventarios.alwaysdata.net
DB_PORT=3306
DB_USER=inventarios
DB_PASSWORD=cambia-esto
DB_NAME=inventarios_db
DB_CONNECTION_LIMIT=10
# alwaysdata acepta TLS; ponlo en true si tu proveedor lo exige.
DB_SSL=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Genera con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ─── Negocio ─────────────────────────────────────────────────────────────────
# Zona horaria de la tienda. El servidor corre en UTC; los reportes se agrupan
# por el día hábil de esta zona.
BUSINESS_TIMEZONE=America/Bogota
CURRENCY=COP
# Con stock negativo permitido, una sobreventa offline se acepta y genera
# alerta en lugar de rechazarse (ver docs/ARQUITECTURA.md §3.4).
ALLOW_NEGATIVE_STOCK=true
DEFAULT_TAX_RATE=19.00
OFFLINE_GRACE_DAYS=7

# ─── Uploads ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
PUBLIC_BASE_URL=http://localhost:3100

# ─── Límites ─────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
SYNC_PUSH_MAX_OPS=200
SYNC_PULL_MAX_ROWS=500
